# AI provider
GROQ_TOKEN=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_FALLBACK_MODEL=
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_RETRY_ATTEMPTS=2
GROQ_MAX_BACKOFF_SECONDS=20
GROQ_ENABLE_FALLBACK=true
GROQ_MAX_CONCURRENT_REQUESTS=3

# Production database
DATABASE_URL=

# Account / sessions
OWNER_EMAILS=
SESSION_DAYS=30
COOKIE_SECURE=1

# Browser/API security
# Leave empty for same-origin deployment. Use a comma-separated list for
# explicitly allowed external origins, e.g. https://app.example.com.
CORS_ORIGINS=
TRUST_PROXY_HEADERS=1
EXPOSE_API_DOCS=0

# SMTP password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Optional response/cache tuning
CACHE_ENABLED=true
CACHE_MIN_CHARS=1
MAX_HISTORY_TURNS=4
MAX_HISTORY_CHARS_PER_TURN=700
MAX_CONTEXT_CHARS=5200
MAX_SYSTEM_CHARS=4200
MAX_USER_CHARS=2400
MAX_MEMORY_ITEMS=8
MELIMI_PROFILE_CHARS=1500
MELIMI_RELEVANT_CHARS=2200
MAX_RESPONSE_TOKENS=1400
GROQ_TEMPERATURE=0.35
