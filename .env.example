# AI provider
GROQ_API_KEY=
# GROQ_TOKEN is also accepted for compatibility.
GROQ_TOKEN=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
GROQ_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_RETRY_ATTEMPTS=2
GROQ_MAX_BACKOFF_SECONDS=20
GROQ_ENABLE_FALLBACK=true
GROQ_MAX_CONCURRENT_REQUESTS=3
GROQ_TEMPERATURE=0.35

# Production database
DATABASE_URL=

# Account / sessions
OWNER_EMAILS=
SESSION_DAYS=30
COOKIE_SECURE=1

# Browser/API security
CORS_ORIGINS=
TRUST_PROXY_HEADERS=1
EXPOSE_API_DOCS=0

# SMTP password reset
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Conversation limits
MAX_HISTORY_TURNS=4
MAX_HISTORY_CHARS_PER_TURN=700
MAX_CONTEXT_CHARS=5200
MAX_SYSTEM_CHARS=4200
MAX_USER_CHARS=2400
MAX_MEMORY_ITEMS=8
MAX_RESPONSE_TOKENS=1400
